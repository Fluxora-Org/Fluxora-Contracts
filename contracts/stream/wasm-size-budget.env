# Reviewable size budget for the deployable fluxora-stream WASM artifact.
# Keep BUILD_COMMAND in sync with CI. Explain intentional growth in the PR.

PACKAGE=fluxora-stream
TARGET=wasm32v1-none
ARTIFACT=target/wasm32v1-none/release/fluxora_stream.wasm
# CI already built and verified all release artifacts. Do not clean this target:
# doing so deletes the factory WASM, optimized binaries and their checksums.
BUILD_COMMAND='cargo build --locked -p fluxora-stream --target wasm32v1-none --release'

# Clean pinned builds: Rust 1.97.1, locked Soroban SDK 27.0.6, release profile.
# Pristine base 5c3fe9c: 118050 bytes (its stale lockfile is synchronized by Cargo).
# PR #2072:             119678 bytes, +1628 (+1.38%) for persisted optional
# stream metadata and the creation authorization/TTL fixes.
# Two independent raw builds and two optimized builds are byte-identical.
# Raw SHA256: 89ecc595ba4da9b160cd5d3ff9564682a413f222adae29a1f01855f6d614d326
# The old file assigned BASELINE_BYTES three times; the final 70920 value was
# already 47130 bytes below the current base. Keep one measured value here.
BASELINE_BYTES=119678

# Soroban caps a contract code entry at 128 KiB. Do not increase this limit.
MAX_BYTES=131072
