# Reviewable size budget for the deployable fluxora-stream WASM artifact.
#
# Keep BUILD_COMMAND in sync with CI. Intentional growth should update this
# file in the same PR with a short explanation in the PR body.

PACKAGE=fluxora-stream
TARGET=wasm32v1-none
ARTIFACT=target/wasm32v1-none/release/fluxora_stream.wasm
BUILD_COMMAND='cargo clean --target wasm32v1-none && cargo build -p fluxora-stream --target wasm32v1-none --release'

# Measured from a clean pinned rebuild (toolchain 1.97.1 per
# rust-toolchain.toml, soroban-sdk 27.0.5, target wasm32v1-none, release
# profile) using BUILD_COMMAND below — reproduced byte-for-byte locally and in
# CI (70920 in both). The previous value, 48128, was carried over from the
# README's historical "~47 KiB" note and never matched an actual build; every
# CI run failed the gate until it was corrected.
# CI prints the exact measured bytes on every run so reviewers can update this
# value after an intentional clean pinned rebuild.
BASELINE_BYTES=70920

# Soroban caps a contract code entry at 128 KiB.
MAX_BYTES=131072

