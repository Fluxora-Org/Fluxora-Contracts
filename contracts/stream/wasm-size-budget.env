# Reviewable size budget for the deployable fluxora-stream WASM artifact.
#
# Keep BUILD_COMMAND in sync with CI. Intentional growth should update this
# file in the same PR with a short explanation in the PR body.

PACKAGE=fluxora-stream
TARGET=wasm32v1-none
ARTIFACT=target/wasm32v1-none/release/fluxora_stream.wasm
BUILD_COMMAND='cargo clean --target wasm32v1-none && cargo build -p fluxora-stream --target wasm32v1-none --release'

# Measured with the pinned toolchain and the pinned Soroban SDK, on the
# unoptimized artifact this script checks (issue #1811 re-baselined it).
#
#   this commit   75689 bytes
#   base commit   71112 bytes  (measured from c48af79 with the same toolchain)
#   previous note 48128 bytes  (copied from a README estimate, not measured — it
#                                did not match a build of the base commit)
#
# So `batch_cancel` and its `BatchCancelOutcome` type cost 4577 bytes; the
# remaining gap to the old number predates this change. CI prints the exact
# measured bytes on every run — update this value after an intentional clean
# pinned rebuild, not from a README estimate.
BASELINE_BYTES=75689
# Baseline measured from a clean pinned rebuild of BUILD_COMMAND on this commit.
#
# The previous value, 48128, was never a real measurement: its own comment says
# it was transcribed from the README's "~47 KiB" note, and the gate had been
# failing long before this change. A clean build of pristine `main` (c48af79)
# measures 70962, i.e. 22834 bytes over the recorded budget. Re-recording the
# number was unavoidable; the honest decomposition for a reviewer is:
#
#   pristine main ............................ 70962   (already +22834 over budget)
#   + cliff_mode (ABI v2) ................... 75159   (+4197 for this change)
#
# The 4197 is one new public entry point (`create_stream_with_cliff_mode`), the
# `CliffMode` contracttype, the extra `Stream` field and `stream_created` field,
# and the mode-aware cliff predicate. `create_stream` is a thin wrapper
# delegating to it, so the validation and token-transfer body is not duplicated.
# That is the deployable cost of one Soroban entry point; there is no second
# copy of the create logic to remove.
#
# CI prints the exact measured bytes on every run so reviewers can update this
# value after an intentional clean pinned rebuild.
BASELINE_BYTES=75159
# Measured from a clean pinned rebuild (toolchain 1.97.1 per
# rust-toolchain.toml, soroban-sdk 27.0.5, target wasm32v1-none, release
# profile) using BUILD_COMMAND below — reproduced byte-for-byte locally and in
# CI (70920 in both). The previous value, 48128, was carried over from the
# README's historical "~47 KiB" note and never matched an actual build; every
# CI run failed the gate until it was corrected.
# CI prints the exact measured bytes on every run so reviewers can update this
# value after an intentional clean pinned rebuild.
BASELINE_BYTES=70920

# Soroban caps a contract code entry at 128 KiB.
MAX_BYTES=131072

